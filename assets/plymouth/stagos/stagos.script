// StagOS boot splash. Boot/shutdown: pulsing ring. Disk unlock: styled as the
// login page (the LUKS passphrase is the login; tty1 autologins after it).
// A thin red progress line runs under the ring while booting. All text is
// pre-rendered images (tools/make-login.py), no fonts needed here.
// Layout constants mirror tools/make-login.py: panel 720x400, box center y 326,
// message y 390, dot step 30 (design px at 2560x1440).
Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.04);

W = Window.GetWidth();
H = Window.GetHeight();
s = W / 2560;
if (H / 1440 < s) {
    s = H / 1440;
}

fun scaled(name) {
    img = Image(name);
    return img.Scale(img.GetWidth() * s, img.GetHeight() * s);
}

bg.image = Image("bg.png").Scale(W, H);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition(0, 0, -10);

logo.image = scaled("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(W / 2 - logo.image.GetWidth() / 2, H / 2 - logo.image.GetHeight() / 2, 0);

panel.image = scaled("panel.png");
panel.x = W / 2 - panel.image.GetWidth() / 2;
panel.y = H / 2 - panel.image.GetHeight() / 2 - 40 * s;
panel.sprite = Sprite(panel.image);
panel.sprite.SetPosition(panel.x, panel.y, 1);
panel.sprite.SetOpacity(0);

dot_img = scaled("dot.png");
dot_step = 30 * s;
box_cy = panel.y + 326 * s;
for (i = 0; i < 32; i++) {
    dots[i] = Sprite(dot_img);
    dots[i].SetOpacity(0);
}

// thin progress line: 1x1 red/grey pixels scaled to the bar (boot only)
bar_w = 480 * s;
bar_h = 3 * s;
if (bar_h < 2) {
    bar_h = 2;
}
bar_x = W / 2 - bar_w / 2;
bar_y = H / 2 + 330 * s;
track.sprite = Sprite(Image("track.png").Scale(bar_w, bar_h));
track.sprite.SetPosition(bar_x, bar_y, 0);
fill.img = Image("bar.png");
fill.sprite = Sprite(fill.img.Scale(1, bar_h));
fill.sprite.SetPosition(bar_x, bar_y, 1);

hint_img = scaled("hint.png");
err_img = scaled("err.png");
signin_img = scaled("signin.png");
msg_y = panel.y + 390 * s;
msg = Sprite(hint_img);
msg.SetOpacity(0);

fun show_msg(img) {
    msg.SetImage(img);
    msg.SetPosition(W / 2 - img.GetWidth() / 2, msg_y, 2);
    msg.SetOpacity(1);
}

fun hide_dots() {
    for (i = 0; i < 32; i++) {
        dots[i].SetOpacity(0);
    }
}

mode = "boot";
tick = 0;
submitted = 0;
failed = 0;

fun refresh_cb() {
    if (mode == "boot") {
        global.tick = tick + 1;
        logo.sprite.SetOpacity(0.85 + 0.15 * Math.Sin(tick / 20));
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

fun progress_cb(duration, progress) {
    if (mode == "boot") {
        w = bar_w * progress;
        if (w < 1) {
            w = 1;
        }
        fill.sprite.SetImage(fill.img.Scale(w, bar_h));
    }
}
Plymouth.SetBootProgressFunction(progress_cb);

fun hide_bar() {
    track.sprite.SetOpacity(0);
    fill.sprite.SetOpacity(0);
}

fun display_password_cb(prompt, bullets) {
    if (submitted) {
        global.failed = 1;
        global.submitted = 0;
    }
    global.mode = "login";
    logo.sprite.SetOpacity(0);
    hide_bar();
    panel.sprite.SetOpacity(1);

    n = bullets;
    if (n > 32) {
        n = 32;
    }
    x0 = W / 2 - (n * dot_step) / 2 + (dot_step - dot_img.GetWidth()) / 2;
    for (i = 0; i < 32; i++) {
        if (i < n) {
            dots[i].SetPosition(x0 + i * dot_step, box_cy - dot_img.GetHeight() / 2, 2);
            dots[i].SetOpacity(1);
        } else {
            dots[i].SetOpacity(0);
        }
    }
    if (failed && bullets == 0) {
        show_msg(err_img);
    } else {
        show_msg(hint_img);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    if (mode == "login") {
        global.submitted = 1;
        hide_dots();
        show_msg(signin_img);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
