// StagOS plymouth splash: centered ring logo, red passphrase prompt.
Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.04);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 0);

// gentle pulse on the logo
fun refresh_cb() {
    t = Math.Sin(Plymouth.GetTime() * 2) * 0.15 + 0.85;
    logo.sprite.SetOpacity(t);
}
Plymouth.SetRefreshFunction(refresh_cb);

// ---- passphrase / password prompt ----
status = "normal";

fun draw_prompt(text, bullets) {
    prompt.image = Image.Text(text, 0.83, 0.83, 0.83);
    prompt.sprite = Sprite(prompt.image);
    prompt.sprite.SetPosition(
        Window.GetWidth() / 2 - prompt.image.GetWidth() / 2,
        logo.y + logo.image.GetHeight() + 40, 1);

    bullet.image = Image.Text(bullets, 0.78, 0.06, 0.18);
    bullet.sprite = Sprite(bullet.image);
    bullet.sprite.SetPosition(
        Window.GetWidth() / 2 - bullet.image.GetWidth() / 2,
        logo.y + logo.image.GetHeight() + 80, 1);
}

fun display_password_cb(prompt_text, bullets) {
    b = "";
    for (i = 0; i < bullets; i++) b += "*";
    draw_prompt("Enter passphrase", b);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    global.prompt.sprite = NULL;
    global.bullet.sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
