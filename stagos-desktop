#!/usr/bin/env bash
# stagos-desktop: macOS-class desktop modules for StagOS. Run as the desktop user (uses sudo).
#   ./stagos-desktop                 all modules, in order
#   ./stagos-desktop keys bar        only the named modules
#   ./stagos-desktop --list          module names
#   DRY_RUN=1 ./stagos-desktop       print state-changing commands instead of running them
# Each module is provision/desktop/NN-name.sh defining stagos_dm_name; all are idempotent.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
# shellcheck source=lib/desktop.sh
source "$HERE/lib/desktop.sh"
# shellcheck source=config/stagos.conf
source "$HERE/config/stagos.conf"
LOCAL_CONF="${STAGOS_LOCAL_CONF:-$HERE/config/local.conf}"
# shellcheck disable=SC1090
if [[ -r "$LOCAL_CONF" ]]; then source "$LOCAL_CONF"; else warn "no $LOCAL_CONF (private values unset; see config/local.conf.example)"; fi


mapfile -t ALL < <(for f in "$HERE"/provision/desktop/[0-9][0-9]-*.sh; do b="$(basename "$f" .sh)"; echo "${b#*-}"; done)

if [[ "${1:-}" == "--list" ]]; then printf '%s\n' "${ALL[@]}"; exit 0; fi
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then sed -n '2,7p' "$0" | sed 's/^# \?//'; exit 0; fi
[[ ${EUID:-$(id -u)} -ne 0 ]] || die "run as your desktop user, not root (modules call sudo)"
[[ "${STAGOS_DESKTOP:-1}" == "1" ]] || { warn "STAGOS_DESKTOP=0, nothing to do"; exit 0; }

# file comparison in the helpers needs cmp (diffutils is in base on a real install)
have cmp || [[ "${DRY_RUN:-0}" == "1" ]] || run sudo pacman -S --needed --noconfirm diffutils

MODS=("$@"); [[ ${#MODS[@]} -gt 0 ]] || MODS=("${ALL[@]}")
modfile() { local g=("$HERE"/provision/desktop/[0-9][0-9]-"$1".sh); [[ -f "${g[0]}" ]] && echo "${g[0]}"; }
for m in "${MODS[@]}"; do modfile "$m" >/dev/null || die "unknown module: $m (try --list)"; done
for m in "${MODS[@]}"; do
  f="$(modfile "$m")"
  log "desktop module: $m"
  # shellcheck disable=SC1090
  source "$f"
  "stagos_dm_${m//-/_}"
  ok "done: $m"
done

log "files changed this run: $DM_CHANGED"
if [[ ${#DM_NOTES[@]} -gt 0 ]]; then
  warn "not applied here (needs a real session):"
  printf '  - %s\n' "${DM_NOTES[@]}" >&2
fi
log "stagos-desktop complete. Log out and back in (or reboot) to pick up group and session changes."
