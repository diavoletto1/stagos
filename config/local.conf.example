# StagOS local (private) config. Copy to config/local.conf; that file is untracked (.gitignore).
# Read by stagos-desktop modules `stag` and `snapshots`. Never commit real values.
# shellcheck disable=SC2034  # sourced

# ---- stag-* services (module: stag) ----
# Each name below becomes a chromium --app launcher at <scheme>://<host>/<name>/
STAGOS_STAG_HOST="CHANGEME.invalid"   # e.g. the tailnet name of the box that serves the stag-* apps
STAGOS_STAG_SCHEME="https"
STAGOS_STAG_PATHS=(tasks maps control lab media fitness)   # /tasks/ /maps/ /control/ /lab/ /media/ /fitness/

# ---- backups (module: snapshots, only used when root is not btrfs) ----
# restic repository, any backend restic supports: sftp:USER@HOST:/path, rest:https://HOST/path, s3:...
STAGOS_RESTIC_REPO=""
# file holding the repo password (chmod 600, outside this repo)
STAGOS_RESTIC_PASSWORD_FILE="$HOME/.config/stagos/restic.pass"
# what to back up (space separated) and how often (systemd OnCalendar)
STAGOS_RESTIC_PATHS="$HOME"
STAGOS_RESTIC_SCHEDULE="daily"

# ---- stag-ntfy notifications (module: link) ----
# The ntfy server (stag-system deploy/ntfy): its own Caddy site on the stag host, port 8443, tailnet only.
# Empty host = STAGOS_STAG_HOST. The user is a read-only ntfy user for this laptop; its password or token
# goes in ~/.config/stagos/ntfy.credentials (600, created empty by the module), never here.
STAGOS_NTFY_HOST=""
STAGOS_NTFY_PORT="8443"
STAGOS_NTFY_USER="stagpad"
STAGOS_NTFY_TOPICS="stag-alerts,stag-agents"

# ---- stag-lab node (module: lab) ----
# The stag-lab web terminal SSHes in from stagmini with its own key for this host. Paste that key's .pub line
# (on stagmini: /var/lib/stag-lab/keys/<host>_ed25519.pub) and stagmini's tailnet address. Empty key = no sshd.
STAGOS_LAB_SSH_PUBKEY=""
STAGOS_LAB_SSH_FROM=""            # e.g. 100.x.y.z (comma separated, CIDR ok)
STAGOS_LAB_METRICS=0              # 1 = prometheus-node-exporter on :9100 for the stag-lab monitor tile
