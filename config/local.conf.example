# StagOS local (private) config. Copy to config/local.conf; that file is untracked (.gitignore).
# Read by stagos-desktop modules `stag` and `snapshots`. Never commit real values.
# shellcheck disable=SC2034  # sourced

# ---- stag-* services (module: stag) ----
# Each name below becomes a chromium --app launcher at <scheme>://<host>/<name>/
STAGOS_STAG_HOST="CHANGEME.invalid"   # e.g. the tailnet name of the box that serves the stag-* apps
STAGOS_STAG_SCHEME="https"
STAGOS_STAG_PATHS=(tasks maps control lab media fitness)   # /tasks/ /maps/ /control/ /lab/ /media/ /fitness/

# ---- backups (module: snapshots, only used when root is not btrfs; command: stag-backup) ----
# restic repository, any backend restic supports. StagOS default: SFTP to the home server over Tailscale SSH,
# e.g. sftp:SERVER:/path/to/restic/LAPTOP (SERVER = the ssh name that works as `ssh SERVER` with no prompt)
STAGOS_RESTIC_REPO=""
# file holding the repo password (chmod 600, outside this repo); `stagos-desktop snapshots` creates a random one
# once if missing. Copy it to a password manager: without it the backups cannot be restored.
STAGOS_RESTIC_PASSWORD_FILE="$HOME/.config/stagos/restic.pass"
# what to back up (space separated; excludes: desktop/backup/backup.exclude)
STAGOS_RESTIC_PATHS="$HOME /etc"
# timer attempts (systemd OnCalendar); a backup is made at most once per STAGOS_BACKUP_EVERY_H hours,
# only on AC power and when the server answers
STAGOS_RESTIC_SCHEDULE="hourly"
STAGOS_BACKUP_EVERY_H=20
# optional: ntfy topic URL pinged when a backup fails, plus a 600 file holding an access token (empty = none)
STAGOS_BACKUP_NTFY_URL=""
STAGOS_BACKUP_NTFY_TOKEN_FILE=""

# ---- stag-ntfy notifications (module: link) ----
# The ntfy server (stag-system deploy/ntfy): its own Caddy site on the stag host, port 8443, tailnet only.
# Empty host = STAGOS_STAG_HOST. The user is a read-only ntfy user for this laptop; its password or token
# goes in ~/.config/stagos/ntfy.credentials (600, created empty by the module), never here.
STAGOS_NTFY_HOST=""
STAGOS_NTFY_PORT="8443"
STAGOS_NTFY_USER="stagpad"
STAGOS_NTFY_TOPICS="stag-alerts,stag-agents"

# ---- stag-lab node (module: lab) ----
# The stag-lab web terminal SSHes in from stagmini with its own key for this host. Paste that key's .pub line
# (on stagmini: /var/lib/stag-lab/keys/<host>_ed25519.pub) and stagmini's tailnet address. Empty key = no sshd.
STAGOS_LAB_SSH_PUBKEY=""
STAGOS_LAB_SSH_FROM=""            # e.g. 100.x.y.z (comma separated, CIDR ok)
STAGOS_LAB_SSH_PORT="22"          # 2222 when Tailscale SSH is on (it takes port 22 on the tailnet); match it in hosts.yaml
STAGOS_LAB_METRICS=0              # 1 = prometheus-node-exporter on :9100 for the stag-lab monitor tile

# ---- MAC privacy (module: network) ----
# Saved wifi connections that keep the hardware MAC (router allowlist / DHCP reservation). Every other wifi network
# gets its own random MAC. Space separated NetworkManager connection names (no spaces in a name; use stag-mac trust for those); see `stag-mac list`.
STAGOS_TRUSTED_NETS=""
