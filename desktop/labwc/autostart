# StagOS labwc autostart (sh). Every service is guarded, so a module that has not been
# installed yet just does not start; missing pieces never block the session.
[ -r "$HOME/.config/stagos/desktop.env" ] && . "$HOME/.config/stagos/desktop.env"
start() { command -v "$1" >/dev/null 2>&1 && { "$@" & }; }

# session bus + portals know where the compositor is (keyring, screenshare, flatpak)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc:wlroots 2>/dev/null

# HiDPI: scale on the internal panel (first eDP output); runs before anything draws
out=$(wlr-randr 2>/dev/null | awk '/^eDP/{print $1; exit}')
[ -n "$out" ] && wlr-randr --output "$out" --scale "${STAGOS_OUTPUT_SCALE:-1.5}"

start swaybg -i /usr/share/stagos/stag-wall-stag.png -m fill
start waybar
if command -v swaync >/dev/null 2>&1; then start swaync; else start mako; fi
start swayosd-server
start nm-applet --indicator
start blueman-applet
start udiskie
# clipboard history (text + images)
start wl-paste --type text --watch cliphist store
start wl-paste --type image --watch cliphist store
start stag-nightlight start
start stag-dock start
start stag-battery
# Cmd-key overrides per app, Cmd-like trackpad gestures
start keyd-application-mapper -d
start libinput-gestures
# idle: lock at 5m, screen off at 6m, lock before sleep (stag-lock = swaylock -f)
swayidle -w \
    timeout 300 'stag-lock' \
    timeout 360 'wlopm --off \*' resume 'wlopm --on \*' \
    before-sleep 'stag-lock' &
