[Unit]
Description=StagOS field log sync to stag-maps
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
# sync is a no-op when the tailnet or stag-maps is unreachable, so it is safe to run on a schedule
ExecStart=/usr/local/bin/stag-field sync
