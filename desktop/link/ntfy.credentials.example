# stag-ntfy credentials for this laptop (module link): ~/.config/stagos/ntfy.credentials, mode 600.
# Read by stag-ntfy-notify as strict KEY=VALUE, never sourced, never printed. Never commit it.
# Fill in ONE of them: the password of the ntfy user named in ~/.config/stagos/link.env (NTFY_USER,
# from STAGOS_NTFY_USER in config/local.conf), or an access token for that user (preferred, revocable).
NTFY_PASSWORD=
NTFY_TOKEN=
